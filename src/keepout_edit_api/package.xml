<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>keepout_edit_api</name>
  <version>0.1.0</version>
  <description>
    Python API for RTK keepout editing: ENU/map conversion, SQLite persistence,
    optional robot_localization FromLL/ToLL/SetDatum. Nav2 reads the same DB via filter_keepout.
  </description>
  <maintainer email="cdf_168@163.com">64k-chen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geographic_msgs</depend>
  <depend>robot_localization</depend>
  <depend>nav2_msgs</depend>
  <exec_depend>keepout_edit_web</exec_depend>
  <exec_depend>python3-fastapi</exec_depend>
  <exec_depend>python3-uvicorn</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
